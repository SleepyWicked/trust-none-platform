# Public site URL (used for social share previews)
NEXT_PUBLIC_SITE_URL=https://trustnonemovie.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
# Required: the webhook refuses all events without it
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bunny Stream — full movie (server-only; never exposed unpaid)
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_MOVIE_VIDEO_ID=your_movie_video_guid
# Library → Security → "Embed view token authentication" key. Strongly recommended:
# makes player links expire so they can't be shared.
BUNNY_TOKEN_AUTH_KEY=your_token_auth_key

# Public trailer (Bunny play/embed URL or a direct .mp4)
NEXT_PUBLIC_TRAILER_URL=
